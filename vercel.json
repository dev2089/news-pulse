{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "functions":{"api/ingest.py":{"maxDuration":60}},
  "rewrites":[
    {"source":"/internal-python-ingest","destination":"/api/ingest"},
    {"source":"/clusters","destination":"/api/index.js?route=clusters"},
    {"source":"/clusters/:id","destination":"/api/index.js?route=cluster-detail&id=:id"},
    {"source":"/timeline","destination":"/api/index.js?route=timeline"},
    {"source":"/ingest/trigger","destination":"/api/index.js?route=ingest-trigger"},
    {"source":"/ingest/status/:jobId","destination":"/api/index.js?route=ingest-status&id=:jobId"}
  ]
}